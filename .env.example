# Keep credentials here on the server. Never prefix them with VITE_.
# Register: https://www.bus-data.dft.gov.uk/
BODS_API_KEY=
# RDM Live Departure Board: Consumer key from the Specification tab.
RDM_API_KEY=
# Optional legacy OpenLDBWS SOAP token; RDM takes precedence when both are set.
DARWIN_TOKEN=
# Enables signed SNS receiver; requires public HTTPS + DfT subscription.
STREET_MANAGER_ENABLED=false
# Optional approved provider bridge returning TrafficSegment[] (see docs/data-sources.md).
TRAFFIC_FEED_URL=
TRAFFIC_FEED_TOKEN=
HOST=127.0.0.1
PORT=8787

# TomTom Orbis v2 traffic tiles; server-side key, shared 5-minute cache.
TOMTOM_API_KEY=
# Hard monthly upstream tile request cap for this deployment (free-tier headroom).
TOMTOM_MONTHLY_TILE_LIMIT=150000
# Open-Meteo, keyless non-commercial API; estimated weather every 15 minutes.
WEATHER_ENABLED=true
# Keyless Reading Fuel Finder mirror; twice-daily source, fetched every 6 hours.
FUEL_ENABLED=true
