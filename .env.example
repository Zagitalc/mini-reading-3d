# Keep credentials here on the server. Never prefix them with VITE_.
# Register: https://www.bus-data.dft.gov.uk/
BODS_API_KEY=
# National Rail OpenLDBWS SOAP token (not an arbitrary RDM JSON product key)
DARWIN_TOKEN=
# Enables signed SNS receiver; requires public HTTPS + DfT subscription.
STREET_MANAGER_ENABLED=false
# Optional approved provider bridge returning TrafficSegment[] (see docs/data-sources.md).
TRAFFIC_FEED_URL=
TRAFFIC_FEED_TOKEN=
HOST=127.0.0.1
PORT=8787
