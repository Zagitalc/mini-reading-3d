{
  "name": "mini-reading-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,map \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json && vite build",
    "cf:dev": "wrangler dev --test-scheduled",
    "test:cloudflare": "node tests/cloudflare.runtime.mjs",
    "cf:check": "npm run build && wrangler deploy --dry-run --outdir dist-worker",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:migrate": "wrangler d1 migrations apply DB --remote",
    "cf:deploy": "npm run build && wrangler deploy",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "data:fetch": "node scripts/fetch-osm.mjs",
    "data:build": "node --import tsx scripts/build-geography.ts",
    "data:gtfs": "node --import tsx scripts/build-gtfs.ts",
    "data:routes": "node --import tsx scripts/build-routes.ts",
    "test:phase-browser": "node tests/phase-browser.mjs",
    "data:roadworks": "node --import tsx scripts/import-roadworks.ts",
    "check": "npm run test && npm run build",
    "data:download": "node scripts/download-data.mjs",
    "test:browser": "node tests/browser-check.mjs"
  },
  "overrides": {
    "miniflare": { "undici": "^7.29.0" }
  },
  "dependencies": {
    "compression": "^1.8.1",
    "csv-parse": "^7.0.2",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.4",
    "fflate": "^0.8.2",
    "geojson-vt": "^4.0.2",
    "maplibre-gl": "6.7.0",
    "proj4": "^2.19.10",
    "three": "0.185.1",
    "vt-pbf": "^3.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@playwright/test": "^1.58.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/geojson-vt": "^3.2.5",
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.0",
    "@types/vt-pbf": "^3.1.1",
    "concurrently": "^9.2.1",
    "miniflare": "^4.20260730.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "wrangler": "^4.129.0"
  }
}
