{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-reading-3d",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "STREET_MANAGER_ENABLED": "true", "WEATHER_ENABLED": "true", "FUEL_ENABLED": "true", "TOMTOM_MONTHLY_TILE_LIMIT": "150000" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mini-reading-3d",
    "database_id": "a53e4c7d-d52e-4774-a893-3c4acd9019f0",
    "migrations_dir": "migrations"
  }]
}
